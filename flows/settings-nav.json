{
  "name": "settings-nav",
  "platform": "ios",
  "steps": [
    { "action": "shell", "cmd": "xcrun simctl terminate booted com.apple.Preferences 2>/dev/null || true" },
    { "action": "wait", "ms": 500 },
    { "action": "shell", "cmd": "xcrun simctl openurl booted 'App-prefs:root'" },
    { "action": "wait", "ms": 3000 },
    { "action": "snapshot" },
    { "action": "screenshot", "label": "initial" },
    { "action": "click", "find": ["通用", "General"], "retry": true },
    { "action": "wait", "ms": 2000 },
    { "action": "verify", "find": ["关于本机", "About"] },
    { "action": "screenshot", "label": "general" },
    { "action": "click", "find": ["设置", "Back", "返回"], "retry": true },
    { "action": "screenshot", "label": "final" }
  ]
}
